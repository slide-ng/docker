# Copy to .env (it is git-ignored) and edit.
SLIDES_PASSWORD=change-me-to-something-long
# Your user and group, so files written to ./out belong to you: run `id -u` and `id -g`.
SLIDES_UID=1000
SLIDES_GID=1000
# What to install in the image: a tarball in ./packages, or an npm name once slide.ng is published.
SLIDE_NG_SOURCE=packages/slide-ng-0.0.0.tgz
