# Copy to .env (it is git-ignored) and edit.
SLIDES_PASSWORD=change-me-to-something-long
# Your user and group, so files written to ./out belong to you: run `id -u` and `id -g`.
SLIDES_UID=1000
SLIDES_GID=1000
# What to install in the image: an npm name such as @slide-ng/core@2.0.0, or a tarball in ./packages.
SLIDE_NG_SOURCE=@slide-ng/core@2.0.0
